---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import t from "../i18n/pt.json";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
  includeFaq?: boolean;
}

const {
  title = t.site.title,
  description = t.site.description,
  ogTitle = t.site.ogTitle,
  ogDescription = t.site.ogDescription,
  noindex = false,
  includeFaq = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, t.site.url).toString();

const faqs = t.faq.items;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && (
      <meta name="robots" content="noindex, nofollow, noarchive" />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={`${t.site.url}/og-image.png`} />
    <meta property="og:image:alt" content={t.site.name} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.site.twitterTitle} />
    <meta name="twitter:description" content={t.site.twitterDescription} />
    <meta name="twitter:image" content={`${t.site.url}/og-image.png`} />

    <meta name="theme-color" content="#fafafa" id="theme-color-meta" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="calculadora" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <script is:inline>
      // Apply theme before first paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var theme =
            localStorage.getItem("theme") ||
            (window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          document.documentElement.classList.toggle("dark", theme === "dark");
          var meta = document.getElementById("theme-color-meta");
          if (meta) meta.content = theme === "dark" ? "#0b0b0d" : "#fafafa";
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": `${t.site.url}/#website`,
            url: t.site.url,
            name: t.site.name,
            description: t.site.description,
            inLanguage: "pt-BR",
            publisher: {
              "@type": "Organization",
              name: t.site.name,
            },
          },
          {
            "@type": "WebPage",
            "@id": `${canonicalUrl}#webpage`,
            url: canonicalUrl,
            name: title,
            isPartOf: { "@id": `${t.site.url}/#website` },
            inLanguage: "pt-BR",
          },
        ],
      })}
    />
    {includeFaq && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faqs.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        })}
      />
    )}
  </head>
  <body class="min-h-screen">
    <a
      href="#calculadora"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-sm focus:bg-elevated focus:px-3 focus:py-2 focus:text-ink"
    >
      Pular para a calculadora
    </a>

    <header class="border-b border-hairline bg-canvas">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3"
        aria-label="Navegação principal"
      >
        <a
          href="/"
          class="flex items-center gap-2 font-semibold tracking-tight text-ink"
          translate="no"
        >
          <span
            class="inline-block h-4 w-4 rounded-full bg-ink"
            aria-hidden="true"></span>
          Calculadora&nbsp;<span class="hidden font-normal text-body sm:inline">Juros Compostos</span>
        </a>
        <div class="flex items-center gap-1 text-sm">
          <a
            href="/sobre/"
            class="hidden rounded-full px-3 py-2 text-body transition-colors hover:text-ink focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none md:block">{t.pages.nav.sobre}</a
          >
          <a
            href="/contato/"
            class="hidden rounded-full px-3 py-2 text-body transition-colors hover:text-ink focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none md:block">{t.pages.nav.contato}</a
          >
          <a
            href="/privacidade/"
            class="hidden rounded-full px-3 py-2 text-body transition-colors hover:text-ink focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none md:block">{t.pages.nav.privacidade}</a
          >
          <a
            href="/termos/"
            class="hidden rounded-full px-3 py-2 text-body transition-colors hover:text-ink focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none md:block">{t.pages.nav.termos}</a
          >
          <span class="mx-1 hidden h-5 w-px bg-hairline md:block" aria-hidden="true"></span>
          <button
            type="button"
            id="theme-toggle"
            class="flex h-9 w-9 items-center justify-center rounded-full text-body transition-colors hover:bg-hairline-soft hover:text-ink focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none"
            aria-label="Alternar modo claro/escuro"
            title="Alternar tema"
          >
            <!-- sun -->
            <svg
              id="icon-sun"
              class="hidden h-4 w-4"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
              ><circle cx="10" cy="10" r="3.4" /><path
                d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M3.9 3.9l1.4 1.4M14.7 14.7l1.4 1.4M16.1 3.9l-1.4 1.4M5.3 14.7l-1.4 1.4" /></svg
            >
            <!-- moon -->
            <svg
              id="icon-moon"
              class="hidden h-4 w-4"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
              ><path
                d="M15.5 12.5A6.5 6.5 0 1 1 7.5 4.5a5.5 5.5 0 0 0 8 8z" /></svg
            >
          </button>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-hairline bg-canvas px-6 py-16 text-body">
      <div class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]">
        <div>
          <a href="/" class="inline-flex items-center gap-2 font-semibold tracking-tight text-ink" translate="no">
            <span class="inline-block h-4 w-4 rounded-full bg-ink" aria-hidden="true"></span>
            Calculadora Juros Compostos
          </a>
          <p class="mt-3 max-w-sm text-sm">{t.footer.tagline}</p>
        </div>
        <div>
          <p class="font-mono text-xs tracking-wide text-mute uppercase">
            {t.footer.recursos}
          </p>
          <ul class="mt-3 space-y-1.5 text-sm">
            <li><a class="text-body transition-colors hover:text-ink" href="/#calculadora">Simulador</a></li>
            <li><a class="text-body transition-colors hover:text-ink" href="/#tabela">Tabela detalhada</a></li>
            <li><a class="text-body transition-colors hover:text-ink" href="/#como-funciona">Como funciona</a></li>
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs tracking-wide text-mute uppercase">
            {t.footer.sobre}
          </p>
          <ul class="mt-3 space-y-1.5 text-sm">
            <li><a class="text-body transition-colors hover:text-ink" href="/sobre/">{t.pages.nav.sobre}</a></li>
            <li><a class="text-body transition-colors hover:text-ink" href="/contato/">{t.pages.nav.contato}</a></li>
            <li><a class="text-body transition-colors hover:text-ink" href="/privacidade/">{t.pages.nav.privacidade}</a></li>
            <li><a class="text-body transition-colors hover:text-ink" href="/termos/">{t.pages.nav.termos}</a></li>
          </ul>
        </div>
      </div>
      <div class="mx-auto mt-12 max-w-6xl border-t border-hairline pt-6">
        <p class="text-xs text-mute">{t.footer.aviso}</p>
        <p class="mt-3 text-xs text-faint">
          © <span id="ano">2026</span> Calculadora de Juros Compostos
        </p>
      </div>
    </footer>

    <script>
      document.getElementById("ano")!.textContent = String(new Date().getFullYear());

      const toggle = document.getElementById("theme-toggle");
      const sun = document.getElementById("icon-sun");
      const moon = document.getElementById("icon-moon");
      const meta = document.getElementById("theme-color-meta");

      function paint(theme: string) {
        const dark = theme === "dark";
        document.documentElement.classList.toggle("dark", dark);
        moon?.classList.toggle("hidden", dark);
        sun?.classList.toggle("hidden", !dark);
        if (meta) meta.content = dark ? "#0b0b0d" : "#fafafa";
      }

      // Initialize the icon visibility to match the saved/preferred theme.
      try {
        const initial = localStorage.getItem("theme") || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        paint(initial);
      } catch (e) {
        paint("light");
      }

      toggle?.addEventListener("click", () => {
        const next = document.documentElement.classList.contains("dark")
          ? "light"
          : "dark";
        try {
          localStorage.setItem("theme", next);
        } catch (e) {
          /* ignore */
        }
        paint(next);
      });
    </script>
  </body>
</html>
