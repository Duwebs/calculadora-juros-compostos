---
import Layout from "../layouts/Layout.astro";
import t from "../i18n/pt.json";

const meta = t.errors.internalError;
Astro.response.status = 500;
---

<Layout
  title={meta.title}
  description={meta.description}
  ogTitle={meta.title}
  ogDescription={meta.description}
  noindex
>
  <section class="mx-auto max-w-2xl px-6 py-28 text-center">
    <p class="font-mono text-6xl font-semibold tracking-tight text-ink">
      {meta.code}
    </p>
    <h1
      class="mt-4 text-3xl font-semibold tracking-tight text-balance text-ink sm:text-4xl"
    >
      {meta.h1}
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-pretty text-base leading-relaxed text-body">
      {meta.body}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex rounded-md bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition-opacity hover:opacity-90">{meta.ctaHome}</a
      >
    </div>
  </section>
</Layout>