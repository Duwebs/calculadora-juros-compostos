---
import Layout from "../layouts/Layout.astro";
import Calculator from "../components/Calculator.astro";
import t from "../i18n/pt.json";

const faqs = [1, 2, 3, 4, 5].map((n) => ({
  q: t.faq[`q${n}` as keyof typeof t.faq] as string,
  a: t.faq[`a${n}` as keyof typeof t.faq] as string,
}));
---

<Layout>
  <!-- Hero -->
  <section class="mesh-gradient bg-canvas px-6 pt-20 pb-14">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-mono text-xs tracking-wide text-body uppercase">
        {t.hero.eyebrow}
      </p>
      <h1
        class="mt-4 text-4xl font-semibold tracking-tight text-balance text-ink sm:text-5xl sm:leading-[1.1]"
      >
        {t.hero.title}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-pretty text-base text-body">
        {t.hero.subtitle}
      </p>
    </div>
  </section>

  <!-- Calculator -->
  <div class="-mt-2 pb-20">
    <Calculator />
  </div>

  <!-- Como funciona -->
  <section id="como-funciona" class="border-t border-hairline bg-canvas px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <p class="font-mono text-xs tracking-wide text-mute uppercase">COMO FUNCIONA</p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink">
        O poder dos juros compostos
      </h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-md border border-hairline bg-elevated p-6">
          <p class="font-mono text-xs text-mute uppercase">Fórmula</p>
          <p
            class="mt-3 rounded-sm border border-hairline bg-hairline-soft px-3 py-2 font-mono text-sm text-ink"
          >
            M = C × (1 + i)<sup>t</sup> + aportes
          </p>
          <p class="mt-3 text-sm text-body">
            O montante cresce sobre o capital, os juros e cada aporte mensal —
            juros sobre juros, período após período.
          </p>
        </div>
        <div class="rounded-md border border-hairline bg-elevated p-6">
          <p class="font-mono text-xs text-mute uppercase">Taxa correta</p>
          <p
            class="mt-3 rounded-sm border border-hairline bg-hairline-soft px-3 py-2 font-mono text-sm text-ink"
          >
            i<sub>m</sub> = (1 + i<sub>a</sub>)<sup>1/12</sup> − 1
          </p>
          <p class="mt-3 text-sm text-body">
            Convertendo a taxa anual para mensal de forma composta — sem a
            aproximação incorreta da divisão simples por 12.
          </p>
        </div>
        <div class="rounded-md border border-hairline bg-elevated p-6">
          <p class="font-mono text-xs text-mute uppercase">Transparência</p>
          <p
            class="mt-3 rounded-sm border border-hairline bg-hairline-soft px-3 py-2 font-mono text-sm text-ink"
          >
            Mês a mês, sem surpresas
          </p>
          <p class="mt-3 text-sm text-body">
            Tabela detalhada com juros do período, acumulado e montante — e a
            simulação fica salva na URL para você compartilhar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="perguntas" class="border-t border-hairline bg-canvas px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <p class="font-mono text-xs tracking-wide text-mute uppercase">FAQ</p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink">
        {t.faq.title}
      </h2>
      <div
        class="mt-8 divide-y divide-hairline rounded-md border border-hairline bg-elevated"
      >
        {
          faqs.map((f, i) => (
            <details class="group px-6 py-4" open={i === 0}>
              <summary class="cursor-pointer list-none rounded-sm text-sm font-medium text-ink marker:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link">
                {f.q}
              </summary>
              <p class="mt-2 text-sm text-body">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
